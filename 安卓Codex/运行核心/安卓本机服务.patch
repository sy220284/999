+        assert!(!local_client_authorized(&[h("Authorization", "Bearer wrong")], "capability"));
+        assert!(!local_client_authorized(&[h("Authorization", "Bearer capability"), h("Authorization", "Bearer capability")], "capability"));
+    }
+    #[test]
+    fn browser_origin_is_refused_even_with_a_valid_capability() {
