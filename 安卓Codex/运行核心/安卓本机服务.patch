+fn local_client_authorized(headers: &[Header], token: &str) -> bool {
+    use subtle::ConstantTimeEq;
+    if headers.iter().any(|header| header.field.equiv("Origin")) { return false; }
+    let mut incoming = headers.iter().filter(|header| header.field.equiv("Authorization"));
+    let Some(header) = incoming.next() else { return false; };
+    if incoming.next().is_some() { return false; }
