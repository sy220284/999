+#[cfg(test)]
+mod android_client_capability_tests {
+    use super::*;
+    fn h(name: &str, value: &str) -> Header { Header::from_bytes(name.as_bytes(), value.as_bytes()).unwrap() }
+    #[test]
+    fn capability_is_required_and_never_accepts_a_duplicate_header() {
