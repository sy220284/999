+// Only the Android host supplies this scoped file; tool subprocesses never receive it.
+#[cfg(target_os = "android")]
+fn android_debug_connection() -> Result<Option<(String, String)>> {
+    use std::io::Read;
+    let Some(path) = std::env::var_os("CODEX_ANDROID_DEBUG_CONNECTION_FILE") else { return Ok(None); };
+    let mut bytes = Vec::new();
+    std::fs::File::open(path)?.take(4097).read_to_end(&mut bytes)?;
+    anyhow::ensure!(bytes.len() <= 4096, "debug connection exceeds budget");
+    let data: serde_json::Value = serde_json::from_slice(&bytes)?;
+    let address = data["address"].as_str().ok_or_else(|| anyhow::anyhow!("missing debug address"))?;
+    let token = data["credential"].as_str().ok_or_else(|| anyhow::anyhow!("missing debug credential"))?;
+    let url = Url::parse(address)?;
+    anyhow::ensure!(url.scheme() == "ws" && url.host_str() == Some("127.0.0.1") && url.port().is_some_and(|p| p > 0) && url.username().is_empty() && url.password().is_none() && url.query().is_none() && url.fragment().is_none() && url.path() == "/", "invalid debug endpoint");
+    anyhow::ensure!((32..=128).contains(&token.len()) && token.bytes().all(|b| b.is_ascii_alphanumeric() || b == b'-' || b == b'_'), "invalid debug credential");
+    Ok(Some((address.to_owned(), token.to_owned())))
+}
