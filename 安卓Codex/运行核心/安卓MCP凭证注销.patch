+#[cfg(target_os = "android")]
+fn android_logout_approval(preview: bool, expected: Option<&str>, name: &str, shared: bool, context: serde_json::Value) -> Result<bool> {
+    use sha2::{Digest, Sha256};
+    let value = serde_json::json!({"name":name,"context":context});
+    let digest = format!("{:x}", Sha256::digest(serde_json::to_vec(&value)?));
+    if preview {
+        println!("{}", serde_json::json!({"name":name,"sharedEnterprise":shared,"sha256":digest}));
+        return Ok(true);
+    }
+    if let Some(expected) = expected { anyhow::ensure!(expected.len()==64 && expected==digest, "MCP credential target changed; inspect again before logout"); }
+    Ok(false)
+}
