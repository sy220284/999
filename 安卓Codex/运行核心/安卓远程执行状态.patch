+#[cfg(target_os = "android")]
+pub(super) fn android_executor_status(environment: &str, transport: &str, state: &str) {
+    if std::env::var_os("CODEX_ANDROID_EXECUTOR_EVENTS").as_deref() != Some(std::ffi::OsStr::new("1")) { return; }
+    use std::io::Write;
+    let value = serde_json::json!({"androidRemoteExecutor":1,"pid":std::process::id(),"environmentId":environment,"transport":transport,"state":state});
+    let mut output = std::io::stdout().lock();
+    let _ = writeln!(output, "{value}"); let _ = output.flush();
+}
